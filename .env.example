# ========================================================
# Aashirwad Hospital — Environment Configuration Example
# ========================================================

# Server Runtime Port
PORT=3000
NODE_ENV=development

# Application Base URL
APP_URL="http://localhost:3000"

# Administrative Session Secret
SESSION_SECRET="CHANGE_ME_SUPER_SECRET_RANDOM_KEY_AT_LEAST_32_CHARS"

# Database Connection (Optional if deploying with PostgreSQL Prisma or MongoDB)
# DATABASE_URL="postgresql://user:password@localhost:5432/aashirwad_hospital?schema=public"
# MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/aashirwad_hospital?retryWrites=true&w=majority"

# Email Provider Configuration (Resend)
# Notifications remain disabled by default until verified API key is supplied.
RESEND_API_KEY="MY_RESEND_API_KEY"

# Optional SMS / WhatsApp Webhook Gateway
# SMS_GATEWAY_URL="https://api.sms-provider.example/send"

# Timezone Configuration (Must always be Asia/Kolkata for patient appointments)
TZ="Asia/Kolkata"
